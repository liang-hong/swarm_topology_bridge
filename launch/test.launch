<launch>
  <!-- 实机应用示例: 每台机载电脑启动本 launch, 用 hostname 或 uav_name 推断本机身份 -->
  <arg name="uav_name" default="" />

  <node pkg="swarm_topology_bridge" type="bridge_node.py" name="swarm_bridge" output="screen">
    <rosparam file="$(find swarm_topology_bridge)/config/topology.yaml" command="load" />
    <param name="uav_name" value="$(arg uav_name)" />
  </node>

  <!-- 通用 Service 代理测试: 经 ZMQ 调用拓扑邻居的 /test_srv/{target} -->
  <node pkg="swarm_topology_bridge" type="test_service_node.py" name="test_service_node" output="screen">
    <param name="uav_name" value="$(arg uav_name)" />
  </node>
</launch>
